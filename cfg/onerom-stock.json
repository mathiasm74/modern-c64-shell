{
  "version": 1,
  "name": "C64 Shell ROM + Stock Fallback",
  "description": "Shell ROM with stock C64 BASIC/KERNAL as a second bank, switchable at runtime via the One ROM Bus Control Protocol (host-control plugin in slot 1); overlays chip_set (loadable ROM set 2) carries the tardis lazy-load command library",
  "chip_sets": [
    {
      "type": "single",
      "chips": [
        {
          "file": "https://images.onerom.org/plugins/system/usb/v0.1.2/plugin.bin",
          "type": "system_plugin",
          "size_handling": "pad"
        }
      ]
    },
    {
      "type": "single",
      "chips": [
        {
          "file": "https://images.onerom.org/plugins/user/host-control/v0.1.0/plugin.bin",
          "type": "user_plugin"
        }
      ]
    },
    {
      "type": "multi",
      "serve_alg": "two_cs_one_addr",
      "chips": [
        {
          "file": "build/kernal.bin",
          "type": "Chip2364",
          "cs1": "active_low"
        },
        {
          "file": "build/basic.bin",
          "type": "Chip2364",
          "cs1": "active_low"
        }
      ]
    },
    {
      "type": "multi",
      "serve_alg": "two_cs_one_addr",
      "chips": [
        {
          "file": "stock-roms/kernal.901227-03.bin",
          "type": "Chip2364",
          "cs1": "active_low"
        },
        {
          "file": "stock-roms/basic.901226-01.bin",
          "type": "Chip2364",
          "cs1": "active_low"
        }
      ]
    },
    {
      "type": "multi",
      "serve_alg": "two_cs_one_addr",
      "chips": [
        {
          "file": "build/overlays.0.bin",
          "type": "Chip2364",
          "cs1": "active_low"
        },
        {
          "file": "build/overlays.1.bin",
          "type": "Chip2364",
          "cs1": "active_low"
        }
      ]
    }
  ]
}
